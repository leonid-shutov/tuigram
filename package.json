{
  "name": "tuigram",
  "version": "1.5.1",
  "description": "Terminal UI client for Telegram",
  "keywords": [
    "telegram",
    "tui",
    "terminal",
    "cli",
    "vim",
    "mtcute",
    "opentui"
  ],
  "author": "Leonid Shutov <leonid.shutov@hey.com>",
  "license": "MIT",
  "homepage": "https://github.com/leonid-shutov/tuigram#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonid-shutov/tuigram.git"
  },
  "bugs": {
    "url": "https://github.com/leonid-shutov/tuigram/issues"
  },
  "bin": {
    "tuigram": "bin/tuigram.js"
  },
  "files": [
    "app-key.json",
    "bin",
    "src",
    "types",
    "CHANGELOG.md",
    "README.md"
  ],
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "dev": "node bin/tuigram.js",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint .",
    "types": "tsc -p tsconfig.json",
    "test": "node --experimental-ffi --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "prepublishOnly": "npm run lint && npm run types && npm test"
  },
  "dependencies": {
    "@leonid-shutov/uncommonjs": "^2.0.0",
    "@mtcute/dispatcher": "^0.32.5",
    "@mtcute/node": "^0.32.5",
    "@opentui/core": "^0.8.4",
    "@opentui/keymap": "^0.8.4",
    "@opentui/qrcode": "^0.8.4",
    "metautil": "6.0.0-alpha.0",
    "string-width": "^9.0.0"
  },
  "devDependencies": {
    "@mtcute/test": "^0.32.5",
    "@mtcute/web": "^0.32.5",
    "@types/node": "^26.4.0",
    "eslint": "^10.14.0",
    "eslint-config-metarhia": "^10.0.1",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2"
  }
}
